<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-grow">
  
  <!-- HERO SECTION -->
  <section class="relative bg-gradient-to-b from-amber-50/60 via-white to-slate-50 border-b border-slate-200/80 pt-12 pb-16 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Column: Headline & CTA -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100/80 border border-amber-300 text-amber-900 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
            </span>
            PPAW Week 7 · Arsitektur MVC & REST API
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1] mb-6">
            Penyajian Menu Lezat, <br class="hidden sm:inline"/>
            <span class="bg-gradient-to-r from-brand-600 via-amber-600 to-amber-500 bg-clip-text text-transparent">
              Backend Modern Berbasis MVC.
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl">
            Solusi digital UMKM <strong><%= config.appName %></strong>. Halaman frontend dirender dinamis menggunakan <strong>EJS & Tailwind CSS</strong>, didukung routing <strong>Express.js</strong>, pemodelan data statis, dan pencatatan audit komprehensif melalui <strong>Middleware Logger</strong>.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a href="#katalog" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-brand-600 to-amber-500 hover:from-brand-700 hover:to-amber-600 text-white font-bold text-sm shadow-lg shadow-brand-500/25 transition-all transform hover:-translate-y-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
              Jelajahi <%= totalProduk %> Menu Pilihan
            </a>
            <a href="#api-tester" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm border border-slate-300 shadow-sm transition-all">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
              Uji Live REST API
            </a>
          </div>

          <!-- Feature checklist -->
          <div class="mt-10 pt-6 border-t border-slate-200/80 grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs font-semibold text-slate-600">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Pola Arsitektur MVC
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              EJS Template Engine
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Middleware Logger
            </div>
          </div>
        </div>

        <!-- Right Column: Live Interactive REST API Tester Widget -->
        <div class="lg:col-span-5" id="api-tester">
          <div class="bg-slate-900 rounded-2xl shadow-2xl border border-slate-800 p-6 text-slate-100 font-mono text-xs">
            
            <!-- Terminal Header -->
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-2 text-slate-400 font-semibold text-[11px]">Backend Live Terminal</span>
              </div>
              <span id="live-indicator" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 text-[10px] border border-emerald-800">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                ONLINE
              </span>
            </div>

            <!-- Terminal Tabs for testing -->
            <div class="flex gap-2 mb-3">
              <button id="btn-tab-status" onclick="testEndpoint('/api/status')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-300 font-semibold transition-colors flex items-center gap-1 text-[11px]">
                <span class="text-emerald-400 font-bold">GET</span> /api/status
              </button>
              <button id="btn-tab-produk" onclick="testEndpoint('/api/produk')" class="px-3 py-1.5 rounded-lg bg-slate-800/60 hover:bg-slate-700 text-slate-300 font-semibold transition-colors flex items-center gap-1 text-[11px]">
                <span class="text-emerald-400 font-bold">GET</span> /api/produk
              </button>
            </div>

            <!-- Current URL requested -->
            <div class="bg-slate-950/80 rounded-lg p-2.5 mb-3 flex items-center justify-between border border-slate-800/80 text-[11px]">
              <span class="text-slate-400">Endpoint Aktif: <span id="active-url" class="text-amber-400 font-bold">/api/status</span></span>
              <span id="response-status" class="text-emerald-400 font-bold">HTTP 200 OK</span>
            </div>

            <!-- Output Box -->
            <div class="relative">
              <pre id="api-output" class="bg-slate-950 text-slate-200 p-4 rounded-xl overflow-x-auto max-h-64 text-[11px] leading-relaxed border border-slate-800/80 shadow-inner">Memuat respons dari backend Express...</pre>
              <button onclick="copyOutput()" class="absolute top-2 right-2 px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-400 text-[10px] transition-colors">
                Copy JSON
              </button>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800 text-[10px] text-slate-500 flex items-center justify-between">
              <span>*Permintaan dicatat oleh Middleware Logger</span>
              <span id="response-time">Waktu respons: ~2 ms</span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- KATALOG PRODUK SECTION (EJS DYNAMIC RENDERING) -->
  <section id="katalog" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold text-brand-600 uppercase tracking-wider mb-2">
          <span>Katalog Kuliner Unggulan</span>
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
          <span>Dikelola via models/produkModel.js</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Pilihan Menu Catering Bu Sumiyati
        </h2>
        <p class="text-slate-500 text-sm mt-1 max-w-xl">
          Seluruh data di bawah ini dirender secara dinamis oleh EJS template engine dari backend Express menggunakan arsitektur MVC.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center gap-2">
        <% kategoriList.forEach(function(kat, idx) { %>
          <button 
            onclick="filterCategory('<%= kat %>')" 
            class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all <%= idx === 0 ? 'bg-slate-900 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200' %>"
            data-category="<%= kat %>">
            <%= kat %>
          </button>
        <% }); %>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
      <% produk.forEach(function(item) { %>
        <div class="product-item group bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1" data-category="<%= item.kategori %>">
          
          <!-- Card Top Bar & Badge -->
          <div class="p-6 pb-4 flex items-center justify-between border-b border-slate-100">
            <span class="font-mono text-xs font-bold text-slate-400">ID #0<%= item.id %></span>
            <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider 
              <%= item.kategori === 'Nasi Box' ? 'bg-blue-50 text-blue-700 border border-blue-200' : '' %>
              <%= item.kategori === 'Prasmanan' ? 'bg-purple-50 text-purple-700 border border-purple-200' : '' %>
              <%= item.kategori === 'Tumpeng' ? 'bg-amber-50 text-amber-700 border border-amber-200' : '' %>
              <%= item.kategori === 'Snack Box' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : '' %>
            ">
              <%= item.kategori %>
            </span>
          </div>

          <!-- Card Body -->
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1.5 text-xs text-amber-500 mb-2">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                <span class="font-bold text-slate-800"><%= item.rating %></span>
                <span class="text-slate-400">· Terjual <%= item.terjual %>+</span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors leading-snug mb-2">
                <%= item.nama %>
              </h3>

              <p class="text-xs text-slate-500 leading-relaxed mb-4">
                <%= item.deskripsi %>
              </p>
            </div>

            <!-- Card Highlights -->
            <div class="pt-4 border-t border-dashed border-slate-200">
              <div class="flex items-start gap-2 text-xs text-slate-600 mb-4 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span class="text-[11px] leading-tight"><%= item.keunggulan %></span>
              </div>

              <div class="flex items-baseline justify-between">
                <div>
                  <span class="text-[11px] font-semibold text-slate-400 block leading-none">Harga Paket</span>
                  <span class="text-xl font-extrabold text-slate-900 tracking-tight"><%= formatRupiah(item.harga) %></span>
                </div>
                <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md">
                  Stok: <%= item.stok %> porsi
                </span>
              </div>
            </div>

          </div>

          <!-- Card Bottom Action -->
          <div class="px-6 py-3 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between text-xs font-semibold">
            <a href="/api/produk/<%= item.id %>" target="_blank" class="text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
              Lihat JSON &rarr;
            </a>
            <button onclick="pesanSimulasi('<%= item.nama %>')" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-brand-600 text-white font-medium text-xs transition-colors">
              Pesan Menu
            </button>
          </div>

        </div>
      <% }); %>
    </div>

  </section>

  <!-- MVC ARCHITECTURE EXPLANATION SECTION -->
  <section class="py-16 bg-white border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold text-brand-600 tracking-wider uppercase mb-2 block">Pola Desain Standar Industri</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Implementasi Model-View-Controller (MVC)</h2>
        <p class="text-slate-500 text-sm mt-2">
          Struktur kode pada tugas Week 7 dipisahkan ke dalam modul-modul independen agar mudah dikembangkan pada tahapan database dan autentikasi berikutnya.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Model Card -->
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg mb-4">
            M
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Model (models/)</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4 flex-grow">
            Mengelola data dan aturan bisnis. Pada file <code class="bg-white px-1.5 py-0.5 rounded border border-slate-200">produkModel.js</code>, data produk dikelola dalam struktur objek terpadu dengan method helper seperti <code class="text-blue-700">getAll()</code> dan <code class="text-blue-700">getById()</code>.
          </p>
          <div class="text-[11px] font-mono text-slate-500 bg-white p-2.5 rounded-lg border border-slate-200">
            Responsibility: Data Layer & Business Logic
          </div>
        </div>

        <!-- View Card -->
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-lg mb-4">
            V
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">View (views/)</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4 flex-grow">
            Menyajikan antarmuka ke pengguna menggunakan template engine <strong class="text-purple-700">EJS</strong> dan utility classes <strong>Tailwind CSS</strong>. Memanfaatkan partials modular seperti <code class="bg-white px-1.5 py-0.5 rounded border border-slate-200">head.ejs</code>, <code class="bg-white px-1.5 py-0.5 rounded border border-slate-200">navbar.ejs</code>, dan <code class="bg-white px-1.5 py-0.5 rounded border border-slate-200">footer.ejs</code>.
          </p>
          <div class="text-[11px] font-mono text-slate-500 bg-white p-2.5 rounded-lg border border-slate-200">
            Responsibility: UI/UX & Dynamic HTML Output
          </div>
        </div>

        <!-- Controller Card -->
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg mb-4">
            C
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Controller (controllers/)</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4 flex-grow">
            Mengatur arus kerja antara request dan response. <code class="bg-white px-1.5 py-0.5 rounded border border-slate-200">homeController.js</code> memanggil data dari Model lalu merender View EJS, sedangkan <code class="bg-white px-1.5 py-0.5 rounded border border-slate-200">apiController.js</code> merespon dalam format JSON standar.
          </p>
          <div class="text-[11px] font-mono text-slate-500 bg-white p-2.5 rounded-lg border border-slate-200">
            Responsibility: Application Flow & Dispatcher
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- KELOMPOK SECTION -->
  <section id="kelompok" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
      
      <div class="relative z-10 max-w-3xl">
        <span class="text-xs font-bold text-amber-400 tracking-wider uppercase mb-2 block">Kolaborasi Proyek Berkelanjutan</span>
        <h2 class="text-3xl font-extrabold tracking-tight mb-4">Tim Pengembang <%= config.kelompok.nama %> (<%= config.kelompok.kelas %>)</h2>
        <p class="text-sm text-slate-300 leading-relaxed mb-8">
          Repository ini dikelola bersama untuk memenuhi tugas <strong>PPAW Week 7</strong> dan akan terus dikembangkan secara berkelanjutan hingga UAS mencakup database MySQL, autentikasi, serta integrasi AI API.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% anggotaKelompok.forEach(function(member, idx) { %>
            <div class="flex items-center gap-3.5 bg-slate-800/80 p-3.5 rounded-xl border border-slate-700/80">
              <div class="w-10 h-10 rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center font-bold text-sm">
                0<%= idx + 1 %>
              </div>
              <div>
                <strong class="text-sm text-white block leading-snug"><%= member.nama %></strong>
                <span class="text-xs font-mono text-amber-300"><%= member.nim %></span>
                <span class="text-[11px] text-slate-400 block leading-tight"><%= member.peran %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

    </div>
  </section>

</main>

<!-- JAVASCRIPT LOGIC UNTUK INTERAKTIVITAS & LIVE API TESTING -->
<script>
  // 1. Live API Tester
  async function testEndpoint(endpoint) {
    const outputEl = document.getElementById('api-output');
    const urlEl = document.getElementById('active-url');
    const statusEl = document.getElementById('response-status');
    const timeEl = document.getElementById('response-time');
    const tabStatus = document.getElementById('btn-tab-status');
    const tabProduk = document.getElementById('btn-tab-produk');

    urlEl.textContent = endpoint;
    outputEl.textContent = 'Mengirim request ke ' + endpoint + '...';

    // Highlight tab aktif
    if (endpoint === '/api/status') {
      tabStatus.className = 'px-3 py-1.5 rounded-lg bg-slate-800 text-amber-300 font-semibold transition-colors flex items-center gap-1 text-[11px] border border-amber-400/30';
      tabProduk.className = 'px-3 py-1.5 rounded-lg bg-slate-800/60 text-slate-400 font-semibold transition-colors flex items-center gap-1 text-[11px]';
    } else {
      tabProduk.className = 'px-3 py-1.5 rounded-lg bg-slate-800 text-amber-300 font-semibold transition-colors flex items-center gap-1 text-[11px] border border-amber-400/30';
      tabStatus.className = 'px-3 py-1.5 rounded-lg bg-slate-800/60 text-slate-400 font-semibold transition-colors flex items-center gap-1 text-[11px]';
    }

    const tStart = performance.now();
    try {
      const res = await fetch(endpoint);
      const data = await res.json();
      const tEnd = performance.now();

      statusEl.textContent = 'HTTP ' + res.status + ' OK';
      statusEl.className = 'text-emerald-400 font-bold';
      timeEl.textContent = 'Waktu respons: ' + (tEnd - tStart).toFixed(1) + ' ms';
      outputEl.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      statusEl.textContent = 'ERROR / OFFLINE';
      statusEl.className = 'text-red-400 font-bold';
      outputEl.textContent = 'Gagal menghubungi ' + endpoint + ': ' + err.message;
    }
  }

  // 2. Filter Kategori Menu
  function filterCategory(category) {
    const items = document.querySelectorAll('.product-item');
    const buttons = document.querySelectorAll('.filter-btn');

    buttons.forEach(btn => {
      if (btn.getAttribute('data-category') === category) {
        btn.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-900 text-white shadow-sm';
      } else {
        btn.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white text-slate-600 hover:bg-slate-100 border border-slate-200';
      }
    });

    items.forEach(item => {
      if (category === 'Semua' || item.getAttribute('data-category') === category) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });
  }

  // 3. Copy JSON output
  function copyOutput() {
    const text = document.getElementById('api-output').textContent;
    navigator.clipboard.writeText(text).then(() => {
      alert('JSON respons berhasil disalin ke clipboard!');
    });
  }

  // 4. Simulasi Pemesanan
  function pesanSimulasi(namaMenu) {
    alert('Simulasi Pemesanan: ' + namaMenu + ' telah dimasukkan ke keranjang pemesanan Catering Bu Sumiyati! (Fitur Cart & Checkout database akan terhubung pada pertemuan selanjutnya).');
  }

  // Inisialisasi awal test API saat halaman selesai dimuat
  document.addEventListener('DOMContentLoaded', () => {
    testEndpoint('/api/status');
  });
</script>

<%- include('partials/footer') %>
